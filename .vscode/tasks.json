{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "全量编译并输出可执行文件",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/Scripts/publish.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "detail": "构建 WebUI 前端后发布单文件独立版（内置全部资源），输出 publish/BlueRandom.exe。快捷键 Ctrl+Shift+B"
        },
        {
            "label": "调试预编译",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/Scripts/build.ps1"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "detail": "供 F5 调试使用：构建 WebUI 前端并编译 Debug 版宿主程序（不打包、不分发）"
        }
    ]
}