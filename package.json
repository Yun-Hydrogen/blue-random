{
  "name": "blue-random",
  "version": "26.10.02",
  "codename": "Shiroko",
  "type": "module",
  "description": "蔚蓝点名-仿《蔚蓝档案》学员招募的随机点名工具",
  "author": "HydrogenRua",
  "scripts": {
    "dev": "vite",
