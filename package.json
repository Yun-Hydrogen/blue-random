{
  "name": "blue-random",
  "version": "26.11.03",
  "codename": "Momoi",
  "private": true,
  "scripts": {
    "dev": "npm --prefix WebUI run dev",
    "build": "npm run build:vite",
    "build:vite": "npm --prefix WebUI run build",
    "build:webui": "npm --prefix WebUI run build",
    "build:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File Scripts/build.ps1 -SkipWebUI",
    "build:app": "npm run build:vite && powershell -NoProfile -ExecutionPolicy Bypass -File Scripts/publish.ps1",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File Scripts/test.ps1",
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -File Scripts/clean.ps1"
  }
}
