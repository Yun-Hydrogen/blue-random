    "js-yaml": "^4.1.0",
    "riz-ui": "https://github.com/Yun-Hydrogen/riz-ui/archive/refs/heads/main.tar.gz",
    "vue": "^3.5.17",
    "vue-router": "^4.6.4"
  },
  "allowScripts": {
    "riz-ui": true,
    "esbuild": true
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.5",
    "esbuild": "^0.28.0",
    "vite": "^8.0.8"
  }
