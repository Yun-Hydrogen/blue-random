<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>BlueRandom</RootNamespace>
    <AssemblyName>BlueRandom</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\public\image\app.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- 单文件发布优化配置：仅在 Release 或执行单文件发布时生效，杜绝污染 Debug 开发环境与 IDE 设计时构建 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <InternalsVisibleTo Include="BlueRandom.Tests" />
  </ItemGroup>

  <!-- 内嵌资源：将 UIAccess、公共素材以及 Vite 编译后的前端静态页面完整内嵌到单文件二进制中 -->
  <ItemGroup>
    <EmbeddedResource Include="..\uiaccess.dll">
      <LogicalName>BlueRandom.uiaccess.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\public\**\*">
      <LogicalName>public.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\dist\**\*">
      <LogicalName>dist.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\package.json">
      <LogicalName>package.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 本地开发时输出公共资源以便快速热调试，但在单文件发布时不外置拷贝 -->
  <ItemGroup>
    <Content Include="..\public\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      <Link>public\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\dist\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      <Link>dist\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <Target Name="PostPublishCleanup" AfterTargets="Publish">
    <ItemGroup>
      <FilesToDelete Include="$(PublishDir)*.xml" />
      <FilesToDelete Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(FilesToDelete)" />
  </Target>

</Project>
