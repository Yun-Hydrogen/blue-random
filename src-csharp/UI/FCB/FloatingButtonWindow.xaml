<Window x:Class="BlueRandom.UI.FCB.FloatingButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blue Random Floating Button"
        Width="240" Height="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- 人数变动脉冲动画 (0.25s) -->
        <Storyboard x:Key="CountPulseStoryboard">
            <DoubleAnimation Storyboard.TargetName="CountScale" Storyboard.TargetProperty="ScaleX"
                             From="1.0" To="1.25" Duration="0:0:0.12" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="CountScale" Storyboard.TargetProperty="ScaleY"
                             From="1.0" To="1.25" Duration="0:0:0.12" AutoReverse="True"/>
        </Storyboard>

        <!-- 胶囊内小按钮基础样式 (透明底 + 圆角 hover 高亮) -->
        <Style x:Key="CapsuleBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#4477AA"/>
            <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI Variable, Microsoft YaHei UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F66B4FF"/>
                                <Setter Property="Foreground" Value="#1A6090"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3366B4FF"/>
                                <Setter Property="Foreground" Value="#0D4A78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 舞台画布：Background 为 null 确保完全鼠标穿透，仅子元素捕获点击 -->
    <Canvas x:Name="StageCanvas" Width="240" Height="240">

        <!-- ====== 1. 顶部人数选择圆弧条 (围绕主按钮圆心呈圆弧条展开，纯白底 + #66CCFF 边框) ====== -->
        <Canvas x:Name="PickerCapsule"
                Width="240" Height="240"
                Canvas.Left="0" Canvas.Top="0"
                RenderTransformOrigin="0.5, 0.5"
                Opacity="0"
                Visibility="Collapsed">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CapsuleScale" ScaleX="0.85" ScaleY="0.85"/>
                    <TranslateTransform x:Name="CapsuleTranslate" Y="12"/>
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- 圆弧背景 Path -->
            <Path x:Name="ArcBackground"
                  Fill="#FFFFFF"
                  Stroke="#66CCFF"
                  StrokeThickness="2">
                <Path.Effect>
                    <DropShadowEffect Color="#0066CC" BlurRadius="12" Direction="270" ShadowDepth="2" Opacity="0.15" RenderingBias="Performance"/>
                </Path.Effect>
            </Path>

            <!-- 弧形径向分割线 1~4 -->
            <Line x:Name="Divider1" Stroke="#4D66AADC" StrokeThickness="1"/>
            <Line x:Name="Divider2" Stroke="#4D66AADC" StrokeThickness="1" Visibility="Collapsed"/>
            <Line x:Name="Divider3" Stroke="#4D66AADC" StrokeThickness="1" Visibility="Collapsed"/>
            <Line x:Name="Divider4" Stroke="#4D66AADC" StrokeThickness="1"/>

            <!-- MIN 按钮 -->
            <Button x:Name="BtnMin" Content="MIN" Click="OnMinClick" 
                    Style="{StaticResource CapsuleBtnStyle}"
                    FontWeight="Bold" FontSize="11"
                    Width="34" Height="20"/>

            <!-- 减号 按钮 -->
            <Button x:Name="BtnMinus" Content="−" Click="OnMinusClick" 
                    Style="{StaticResource CapsuleBtnStyle}"
                    FontWeight="Bold" FontSize="20"
                    Width="24" Height="26"/>

            <!-- 人数徽章 (纯正 #66CCFF 蓝底白字圆角方块) -->
            <Border x:Name="CountBorder" Width="34" Height="26" Background="#66CCFF" CornerRadius="8"
                    RenderTransformOrigin="0.5, 0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="CountScale" ScaleX="1.0" ScaleY="1.0"/>
                        <RotateTransform x:Name="CountRotate" Angle="0"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <TextBlock x:Name="TxtCount" Text="1" FontWeight="Bold" FontSize="18" 
                           FontFamily="Bahnschrift, Segoe UI Variable, Microsoft YaHei UI"
                           Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,-1,0,0"/>
            </Border>

            <!-- 加号 按钮 -->
            <Button x:Name="BtnPlus" Content="+" Click="OnPlusClick" 
                    Style="{StaticResource CapsuleBtnStyle}"
                    FontWeight="Bold" FontSize="20"
                    Width="24" Height="26"/>

            <!-- MAX 按钮 -->
            <Button x:Name="BtnMax" Content="MAX" Click="OnMaxClick" 
                    Style="{StaticResource CapsuleBtnStyle}"
                    FontWeight="Bold" FontSize="11"
                    Width="34" Height="20"/>
        </Canvas>

        <!-- ====== 2. 左侧取消按钮 (X, 直径 44px, 柔粉色系, 位于圆弧左端点正下方) ====== -->
        <Button x:Name="BtnCancel" Click="OnCancelPickerClick"
                Canvas.Left="42.6" Canvas.Top="126"
                Width="44" Height="44" Cursor="Hand"
                RenderTransformOrigin="0.5, 0.5"
                Opacity="0" Visibility="Collapsed"
                FocusVisualStyle="{x:Null}">
            <Button.RenderTransform>
                <ScaleTransform x:Name="CancelScale" ScaleX="1.0" ScaleY="1.0"/>
            </Button.RenderTransform>
            <Button.Effect>
                <DropShadowEffect Color="#FF5C75" BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.25" RenderingBias="Performance"/>
            </Button.Effect>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BdCancel" Background="#FF9494" BorderBrush="#FFB0B9" BorderThickness="2" CornerRadius="22">
                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 18,6 L 6,18 M 6,6 L 18,18" 
                                      Stroke="#FFFFFF" StrokeThickness="2.8" 
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BdCancel" Property="BorderBrush" Value="#FF5A6E"/>
                            <Setter TargetName="BdCancel" Property="Background" Value="#FF8080"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BdCancel" Property="Background" Value="#E66A6A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- ====== 3. 主悬浮按钮 (精确居中于 (120, 120)，纯白底 + 2px 蔚蓝边框，带透亮悬浮阴影) ====== -->
        <Border x:Name="MainButtonBorder"
                Canvas.Left="95" Canvas.Top="95"
                Width="50" Height="50"
                CornerRadius="25"
                Background="#FFFFFF"
                BorderBrush="#66CCFF"
                BorderThickness="2"
                Cursor="Hand"
                MouseDown="OnMainButtonMouseDown"
                MouseMove="OnMainButtonMouseMove"
                MouseUp="OnMainButtonMouseUp">
            <Border.Effect>
                <DropShadowEffect Color="#0066CC" BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.16" RenderingBias="Performance"/>
            </Border.Effect>
            <Grid ClipToBounds="True" IsHitTestVisible="False">
                <Image x:Name="ButtonIcon" Width="40" Height="40" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
        </Border>

        <!-- ====== 4. 右侧确认按钮 (✓, 直径 44px, 天蓝色系, 位于圆弧右端点正下方) ====== -->
        <Button x:Name="BtnConfirm" Click="OnConfirmPickerClick"
                Canvas.Left="153.4" Canvas.Top="126"
                Width="44" Height="44" Cursor="Hand"
                RenderTransformOrigin="0.5, 0.5"
                Opacity="0" Visibility="Collapsed"
                FocusVisualStyle="{x:Null}">
            <Button.RenderTransform>
                <ScaleTransform x:Name="ConfirmScale" ScaleX="1.0" ScaleY="1.0"/>
            </Button.RenderTransform>
            <Button.Effect>
                <DropShadowEffect Color="#0099FF" BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.28" RenderingBias="Performance"/>
            </Button.Effect>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BdConfirm" Background="#66CCFF" BorderBrush="#A6E9FF" BorderThickness="2" CornerRadius="22">
                        <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 20,6 L 9,17 L 4,12" 
                                      Stroke="#FFFFFF" StrokeThickness="2.8" 
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BdConfirm" Property="BorderBrush" Value="#17E3F2"/>
                            <Setter TargetName="BdConfirm" Property="Background" Value="#52C2F7"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BdConfirm" Property="Background" Value="#38B3EE"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Canvas>
</Window>
