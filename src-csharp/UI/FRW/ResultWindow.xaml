<Window x:Class="BlueRandom.UI.FRW.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blue Random Recruitment Result"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Width="740"
        Height="669"
        KeyDown="OnWindowKeyDown">

    <!-- 内容包围盒（非全屏）：仅容纳立绘 + 面板 + 动画余量，降低 layered 窗口软件光栅化面积 -->
    <Grid x:Name="RootContainer" Background="Transparent">

        <!-- 纵向居中容器：招募主面板 -->
        <StackPanel x:Name="CenterContainer" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">

            <!-- 核心招募结果主面板容器 (承载入场飞入与缩放动画，将阴影独立隔离以确保文本绝对清晰) -->
            <Grid x:Name="PanelContainer"
                  HorizontalAlignment="Center"
                  RenderTransformOrigin="0.5, 0.5"
                  UseLayoutRounding="True"
                  SnapsToDevicePixels="True">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PanelScale" ScaleX="0.85" ScaleY="0.85"/>
                        <TranslateTransform x:Name="PanelTranslate" Y="16"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <!-- 独立底层阴影：纯投影，不包含任何文本与内容，彻底隔离像素着色器栅格化 -->
                <Border x:Name="PanelShadow"
                        Background="#EBFFFFFF"
                        CornerRadius="24"
                        Margin="0">
                    <Border.Effect>
                        <DropShadowEffect Color="#061630" BlurRadius="20" ShadowDepth="6" Opacity="0.16" RenderingBias="Performance"/>
                    </Border.Effect>
                </Border>

                <!-- 核心招募结果主面板 (半透纯白 + 4px 蔚蓝边框 + 24px 圆角，无任何 Effect 干扰，直绘硬件矢量字) -->
                <Border x:Name="MainPanel"
                        Background="#EBFFFFFF"
                        BorderBrush="#66CCFF"
                        BorderThickness="4"
                        CornerRadius="24"
                        Padding="48,24,48,20"
                        MinWidth="420"
                        UseLayoutRounding="True"
                        SnapsToDevicePixels="True"
                        TextOptions.TextFormattingMode="Ideal"
                        TextOptions.TextRenderingMode="Auto"
                        RenderOptions.ClearTypeHint="Enabled"
                        MouseDown="OnPanelMouseDown">
                    <StackPanel HorizontalAlignment="Center">
                    <!-- 信件行 1 (前 1~5 抽) -->
                    <StackPanel x:Name="TopRowPanel" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Center"/>

                    <!-- 信件行 2 (第 6~10 抽，人数 > 5 时展示，行间距 44px) -->
                    <StackPanel x:Name="BottomRowPanel" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Center" 
                                Margin="0,44,0,0" 
                                Visibility="Collapsed"/>

                    <!-- 空结果提示 -->
                    <TextBlock x:Name="TxtEmptyResult"
                               Text="暂无抽取结果"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#B9DCFF"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,10"
                               Visibility="Collapsed"/>

                    <!-- 底部关闭操作胶囊条：唯一可点击关闭区域（未解锁时点击无效） -->
                    <Border x:Name="HintPill"
                            Background="#66CCFF"
                            Height="32"
                            CornerRadius="16"
                            Padding="26,0,26,0"
                            HorizontalAlignment="Center"
                            Margin="0,24,0,2"
                            Cursor="Hand"
                            MouseDown="OnClosePillMouseDown">
                        <TextBlock x:Name="TxtHint"
                                   Text="正在揭晓招募结果..."
                                   Foreground="#FFFFFF"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</Grid>
</Window>
