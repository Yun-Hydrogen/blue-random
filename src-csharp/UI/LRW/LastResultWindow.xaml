<Window x:Class="BlueRandom.UI.LRW.LastResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="上次抽取结果"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border x:Name="RootCard"
            CornerRadius="18"
            BorderThickness="3"
            BorderBrush="#66CCFF"
            Background="#F2FFFFFF"
            Padding="14,12,14,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270"
                              Opacity="0.22" Color="#08233D"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="-8"/>
        </Border.RenderTransform>

        <DockPanel>
            <!-- 标题栏 -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="4" Height="16" CornerRadius="2" Background="#66CCFF" Margin="0,0,8,0"/>
                    <TextBlock Text="上次抽取结果"
                               FontSize="14" FontWeight="Bold" Foreground="#16283A"
                               VerticalAlignment="Center"/>
                    <Border x:Name="CountBadge" Margin="8,0,0,0" Padding="7,1"
                            CornerRadius="9" Background="#E6F4FF" VerticalAlignment="Center">
                        <TextBlock x:Name="CountText" Text="0 人" FontSize="11" Foreground="#2E86C8"/>
                    </Border>
                </StackPanel>

                <Button x:Name="CloseButton" Width="24" Height="24"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        ToolTip="关闭" Click="OnCloseClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" CornerRadius="12" Background="Transparent">
                                <TextBlock x:Name="Glyph" Text="✕" FontSize="12" FontWeight="Bold"
                                           Foreground="#7A93A8"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#E9F3FA"/>
                                    <Setter TargetName="Glyph" Property="Foreground" Value="#2E86C8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <TextBlock x:Name="TimeText" DockPanel.Dock="Top"
                       FontSize="10.5" Foreground="#8AA0B2" Margin="0,0,0,8"/>

            <TextBlock x:Name="EmptyText" DockPanel.Dock="Top"
                       Text="暂无抽取结果" FontSize="12" Foreground="#93A9BA"
                       Margin="0,14,0,14" HorizontalAlignment="Center"
                       Visibility="Collapsed"/>

            <!-- 底部固定区域：自动关闭倒计时 + 操作提示（先于 ScrollViewer 停靠，避免被列表覆盖） -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                <TextBlock x:Name="CountdownText"
                           FontSize="10.5" FontWeight="SemiBold" Foreground="#2E86C8"
                           HorizontalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock Text="点按 ✕ 可暂时关闭，下次抽取后自动显示"
                           FontSize="10" Foreground="#93A9BA"
                           HorizontalAlignment="Center" Margin="0,1,0,0"/>
            </StackPanel>

            <ScrollViewer x:Name="ListScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="540"
                          Margin="0,0,0,6">
                <ItemsControl x:Name="ResultList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,2" Padding="8,6" CornerRadius="9" Background="#F5FAFF">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="12" Height="12" CornerRadius="6"
                                            Background="{Binding BadgeBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13" Foreground="#22384C"
                                               Margin="9,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
